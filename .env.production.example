ENVIRONMENT=production
# Comma-separated, exact browser origins allowed to call the API.
ALLOWED_ORIGINS=https://app.example.com
# Mount or sync processed artifacts at /app/data; this is intentionally not in Git.
URBAN_HEAT_DATA_DIR=/app/data
# Optional: only set when an API gateway or non-browser client supplies this secret.
# URBAN_HEAT_API_KEY=
